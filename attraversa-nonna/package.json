{
  "name": "attraversa-nonna",
  "private": true,
  "version": "1.0.0",
  "description": "Attraversa, Nonna! — gioco arcade per iPhone: accompagna la nonna dall'altra parte della strada.",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:web": "tsc --noEmit && vite build --mode singlefile",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bot": "node scripts/run-ts.mjs ./scripts/bot-report.ts 40",
    "perf": "npm run build && node scripts/perf.mjs",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "assets": "node scripts/make-assets.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.2",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/status-bar": "^8.0.3",
    "@fontsource/fredoka": "^5.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "playwright": "1.56.1",
    "typescript": "^5.9.3",
    "vite": "^8.0.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.2"
  }
}
