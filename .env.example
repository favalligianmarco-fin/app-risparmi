# ---------------------------------------------------------------------------
# sync-spese — configurazione
#
# Copia questo file in `.env` e riempi i valori.
# `.env` e la chiave privata .pem sono in .gitignore: non devono MAI essere
# committati.
# ---------------------------------------------------------------------------

# --- Applicazione Enable Banking ------------------------------------------
# ID dell'applicazione registrata su https://enablebanking.com/cp/applications
# È anche il `kid` del JWT con cui firmiamo ogni richiesta.
EB_APPLICATION_ID=00000000-0000-0000-0000-000000000000

# Percorso ASSOLUTO del file .pem con la chiave privata RSA scaricata alla
# registrazione dell'applicazione. Il file resta fuori dal repo.
# Consigliato: chmod 600.
EB_PRIVATE_KEY_PATH=/percorso/assoluto/alla/chiave.pem

# Origin dell'API. Da cambiare solo se Enable Banking lo comunica.
EB_API_ORIGIN=https://api.enablebanking.com

# --- Flusso di autorizzazione ---------------------------------------------
# URL di redirect. DEVE essere identico a uno di quelli registrati nel
# control panel dell'applicazione. Il comando `auth` mette in ascolto un
# server locale su questo host/porta per catturare il `code` in automatico.
EB_REDIRECT_URL=http://localhost:8080/auth_redirect

# Banca (ASPSP). Il nome deve corrispondere ESATTAMENTE a quello restituito
# da `sync-spese banks --country IT`. Non tirare a indovinare: eseguilo.
EB_ASPSP_NAME=UniCredit
EB_ASPSP_COUNTRY=IT

# personal | business
EB_PSU_TYPE=personal

# Lingua della UI della banca durante l'autorizzazione (ISO 639-1).
EB_LANGUAGE=IT

# Durata richiesta del consenso, in giorni.
# Se vuoto usa il massimo consentito dalla banca (`maximum_consent_validity`
# restituito da /aspsps). Se il valore supera il massimo viene troncato.
EB_CONSENT_DAYS=

# --- Header PSU (opzionali, avanzati) --------------------------------------
# Alcune banche impongono un rate limit molto stretto (anche 4 chiamate al
# giorno per conto) sulle richieste "unattended", cioè senza utente presente,
# e lo allentano se vengono forniti gli header PSU.
# REGOLA: o si forniscono TUTTI gli header richiesti dalla banca, o NESSUNO.
# Fornirne solo una parte causa un 422 PSU_HEADER_NOT_PROVIDED.
# Lascia vuoto per il fetch in background (comportamento predefinito).
EB_PSU_IP_ADDRESS=
EB_PSU_USER_AGENT=

# --- Applicazione locale ---------------------------------------------------
# Identificativo del proprietario dei dati. Finisce in ogni tabella.
# Oggi ci sei solo tu, domani forse no: non è hardcodato da nessuna parte.
APP_USER_ID=local

# Percorso del database SQLite (relativo alla root del progetto o assoluto).
DATABASE_PATH=data/spese.sqlite3

# Timeout HTTP in secondi.
HTTP_TIMEOUT=60

# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
